# GEMINI_API_KEY: Optional if using cloud Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# OpenAI (ChatGPT) API Key
OPENAI_API_KEY=

# OpenRouter API Key
OPENROUTER_API_KEY=

# Anthropic Claude API Key (supports CLAUDE_API_KEY or ANTHROPIC_API_KEY)
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AI Provider Configuration (default: ollama)
# Options: ollama | gemini | claude | chatgpt | openrouter | mock | disabled
AI_PROVIDER="ollama"
AI_MODEL="qwen2.5:7b"
AI_BASE_URL="http://localhost:11434"
AI_API_KEY=
AI_ALLOW_CLOUD="true"

# Banking Sandbox & Security
BANK_SANDBOX_MODE="true"
ENCRYPTION_MASTER_SALT="local-secure-salt-key"

